{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "moeca",
  "version": "0.1.0",
  "identifier": "dev.moeca.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "moeca",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://127.0.0.1:* http://localhost:*; media-src 'self' data: asset: http://127.0.0.1:* http://localhost:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "bin/orchestra-gateway",
      "bin/orchestra-hostagent",
      "bin/orchestra-sandbox"
    ],
    "resources": {
      "../configs": "configs"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: SHOTA MOUE (BXS59LRB3N)"
    }
  }
}
